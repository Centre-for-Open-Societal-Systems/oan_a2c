    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const randomId = Math.random().toString(36).substring(2, 8);",
                                    "const randomNumber = Math.floor(10000000 + Math.random() * 90000000);",
                                    "const randomPhone = `09${randomNumber}`;",
                                    "const randomEmail = `user_${randomId}@bank.com`;",
                                    "const randomPassword = `Pass_${randomId}!123`;",
                                    "pm.collectionVariables.set(\"user_email\", randomEmail);",
                                    "pm.collectionVariables.set(\"user_password\", randomPassword);",
                                    "pm.collectionVariables.set(\"user_phone\", randomPhone);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/method/oan_a2c.api.v1.auth.register_user",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "oan_a2c.api.v1.auth.register_user"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{user_email}}\",\n    \"full_name\": \"{{user_full_name}}\",\n    \"password\": \"{{user_password}}\",\n    \"phone_number\": \"{{user_phone}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.access_token) {",
                                    "        pm.collectionVariables.set(\"jwt_token\", jsonData.data.access_token);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/method/oan_a2c.api.auth.login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "oan_a2c.api.auth.login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"usr\": \"{{user_email}}\",\n    \"pwd\": \"{{user_password}}\",\n    \"remember_me\": {{remember_me}}\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                }
            ]
        },
