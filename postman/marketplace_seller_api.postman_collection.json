        {
            "name": "Applicants",
            "item": [
                {
                    "name": "List Applicants",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Verify multi-tenancy isolation\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('applicants');",
                                    "    ",
                                    "    // If expected_bank is set in the environment, we can strictly assert",
                                    "    // that no applications from other banks bleed into this response.",
                                    "    let expectedBank = pm.environment.get(\"expected_bank\");",
                                    "    if (expectedBank && jsonData.data.applicants.length > 0) {",
                                    "        jsonData.data.applicants.forEach(app => {",
                                    "            // Assuming 'bank' is returned in the fields (you may need to include it in the frappe.get_all fields list if strict client-side validation is desired)",
                                    "            if(app.bank) {",
                                    "                pm.expect(app.bank).to.eql(expectedBank);",
                                    "            }",
                                    "        });",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}",
                                "type": "text"
                            }
