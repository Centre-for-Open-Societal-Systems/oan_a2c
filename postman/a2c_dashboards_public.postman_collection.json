{
  "info": {
    "_postman_id": "a2c-programme-dashboards-public",
    "name": "OAN A2C — Programme Dashboards (Public)",
    "description": "Aggregate chart data for the OAN programme dashboards: GET /api/v1/charts/{chart_id}.\n\nPublic: no Authorization header is sent. Rows are counts and sums only, never a farmer name, phone, ID or record id. Responses are cached for 15 minutes per chart and filter set, so a record change can take that long to show. Calls are rate limited per IP.\n\nFilters (all optional, `all` means none): `provider` (bank id), `region` and `woreda` (comma-separated names, case-insensitive).\n\nSet `base_url` to the A2C site, e.g. http://localhost:8000 locally. This collection needs no credentials and contains none.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. KPIs (whole programme)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/charts/a2cKpis",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "charts",
            "a2cKpis"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"Envelope is success with a data array\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});",
              "",
              "var expectedColumns = [\"providers_onboarded\", \"providers_onboarding\", \"providers_total\", \"consent_requests\", \"consents_approved\", \"consents_pending\", \"consents_declined\", \"applications_total\", \"applications_in_progress\", \"loans_approved\", \"loans_declined\", \"loans_pending\", \"data_shares_total\", \"data_shares_delivered\", \"data_shares_failed\", \"data_shares_pending\", \"records_shared\", \"loan_value_approved\", \"loan_value_requested\", \"farmers_enrolled\"];",
              "pm.test(\"Rows carry the columns the dashboard reads\", function () {",
              "    jsonData.data.forEach(function (row) {",
              "        pm.expect(row).to.include.all.keys(expectedColumns);",
              "    });",
              "});",
              "",
              "var personalFields = [\"first_name\", \"last_name\", \"phone_number\", \"email\", \"farmer_fayda_id\", \"id_number\", \"field_value\", \"farmer_profile\", \"consent_id\", \"application_id\"];",
              "pm.test(\"No row carries personal data or record ids\", function () {",
              "    jsonData.data.forEach(function (row) {",
              "        pm.expect(row).to.not.have.any.keys(personalFields);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
